DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
LOG_LEVEL=INFO

# --- JWT Authentication (Step 3) ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# Never commit the real value. Store in .env locally; use a secret manager in prod.
JWT_SECRET_KEY=<generate-a-long-random-string-and-replace-this>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# --- Redis / Caching (Step 6) ---
# Local dev (docker compose up redis):
#   REDIS_URL=redis://localhost:6379
# Upstash managed Redis (TLS):
#   REDIS_URL=rediss://:<token>@<host>:6380
# Required — the app refuses to start if this is missing (same policy as DATABASE_URL).
REDIS_URL=redis://localhost:6379
# How long a cached flag is considered fresh (seconds) before re-fetching from Postgres.
# Default: 10.  Lower for faster propagation of flag changes in dev; raise in prod for throughput.
CACHE_TTL_SECONDS=10
